{
  "name": "dropbox-mcp-http",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone Dropbox API v2 MCP with per-agent broker OAuth",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/http.js",
    "stdio": "node dist/index.js",
    "dev": "tsx src/http.ts",
    "format": "prettier --write src test docs/*.json *.json *.md",
    "lint": "prettier --check src test docs/*.json *.json *.md",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.1",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.3"
  }
}
