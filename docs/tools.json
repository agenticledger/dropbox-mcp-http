    },
    "example": {
      "note": "Schema-derived mock inputs; no live Dropbox data.",
      "arguments": {
        "base64": "eA==",
        "confirm": true
      }
    }
  },
  {
    "name": "dropbox_session_append",
    "description": "Append at most 8 MiB at the exact byte offset; on incorrect_offset inspect the returned category then explicitly reconcile offset. CONSEQUENCE: changes Dropbox data or sharing. Requires DROPBOX_ENABLE_WRITES=true and confirm=true. Never automatically retried.",
    "write": true,
    "inputSchema": {
      "type": "object",
      "properties": {
