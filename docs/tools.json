  {
    "name": "dropbox_upload",
    "description": "Upload one file, max 8 MiB (below 150 MiB simple upload limit). Large files: session_start, session_append, session_finish in order. Send expectedHash to verify input. CONSEQUENCE: changes Dropbox data or sharing. Requires DROPBOX_ENABLE_WRITES=true and confirm=true. Never automatically retried.",
    "write": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 2000
        },
        "mode": {
          "type": "string",
          "enum": ["add", "overwrite"],
          "default": "add"
        },
        "autorename": {
          "type": "boolean",
          "default": false
        },
        "mute": {
          "type": "boolean",
          "default": false
        },
        "strict_conflict": {
          "type": "boolean",
          "default": true
        },
        "base64": {
          "type": "string",
          "maxLength": 11184812,
          "description": "Canonical base64 bytes, at most 8 MiB decoded. Finney MCP File Args may expand {\"$file\":\"<agent-owned path>\"} before transmission. This server never reads local paths."
        },
        "expectedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "account": {
          "type": "string",
          "maxLength": 128
        },
        "pathRoot": {
          "type": "string",
          "pattern": "^\\d+$",
          "maxLength": 128,
          "description": "Explicit namespace_id path root. User tokens only; team support is unqualified."
        },
        "confirm": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["path", "base64", "confirm"],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "example": {
      "note": "Schema-derived mock inputs; no live Dropbox data.",
      "arguments": {
        "path": "/mcp-scratch/example.txt",
        "base64": "eA==",
        "confirm": true
      }
    }
  },
  {
    "name": "dropbox_session_start",
    "description": "Start a sequential upload session with at most 8 MiB. Keep session_id private; do not start parallel appends. CONSEQUENCE: changes Dropbox data or sharing. Requires DROPBOX_ENABLE_WRITES=true and confirm=true. Never automatically retried.",
    "write": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "base64": {
          "type": "string",
          "maxLength": 11184812,
