            }
          },
          "required": ["session_id", "offset"],
          "additionalProperties": false
        },
        "close": {
          "type": "boolean",
          "default": false
        },
        "base64": {
          "type": "string",
          "maxLength": 11184812,
          "description": "Canonical base64 bytes, at most 8 MiB decoded. Finney MCP File Args may expand {\"$file\":\"<agent-owned path>\"} before transmission. This server never reads local paths."
        },
        "account": {
          "type": "string",
          "maxLength": 128
        },
        "pathRoot": {
          "type": "string",
          "pattern": "^\\d+$",
          "maxLength": 128,
          "description": "Explicit namespace_id path root. User tokens only; team support is unqualified."
        },
        "confirm": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["cursor", "base64", "confirm"],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
