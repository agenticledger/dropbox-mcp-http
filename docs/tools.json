        },
        "close": {
          "type": "boolean",
          "default": false
        },
        "account": {
          "type": "string",
          "maxLength": 128
        },
        "pathRoot": {
          "type": "string",
          "pattern": "^\\d+$",
          "maxLength": 128,
          "description": "Explicit namespace_id path root. User tokens only; team support is unqualified."
        },
        "confirm": {
