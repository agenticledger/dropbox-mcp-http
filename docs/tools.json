        },
        "commit": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 2000
            },
            "mode": {
              "type": "string",
              "enum": ["add", "overwrite"],
              "default": "add"
            },
            "autorename": {
              "type": "boolean",
              "default": false
            },
            "mute": {
              "type": "boolean",
              "default": false
            },
            "strict_conflict": {
